{
  "name": "accshift",
  "version": "1.0.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "check": "vp check && vp run check:frontend && vp run check:rust",
    "check:frontend": "svelte-check --tsconfig ./tsconfig.json",
    "check:rust": "cargo check --workspace",
    "test:rust": "cargo test --workspace",
    "fmt:check": "cargo fmt --all --check",
    "clippy": "cargo clippy --workspace -- -D warnings",
    "preview": "vp preview",
    "dev:mcp": "tauri dev --config src-tauri/tauri.mcp.conf.json --features mcp-bridge",
    "dev:mock": "node scripts/dev-mock.mjs",
    "tauri": "tauri",
    "prepare": "vp config"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-deep-link": "^2.4.9",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@tsconfig/svelte": "^5.0.8",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.8",
    "vite-plus": "0.2.8",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "overrides": {
      "vite": "npm:@voidzero-dev/vite-plus-core@0.2.8",
      "vitest": "4.1.10"
    }
  }
}
