{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Accshift",
  "version": "1.0.5",
  "identifier": "com.accshift.desktop",
  "mainBinaryName": "accshift-gui",
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis",
      "deb",
      "rpm",
      "appimage",
      "app",
      "dmg"
    ],
    "externalBin": [
      "binaries/accshift"
    ],
    "category": "Utility",
    "shortDescription": "One-click account switcher for Steam, Riot, Battle.net, Epic and more",
    "longDescription": "Accshift switches game launcher accounts in one click: Steam, Riot Games (Valorant, League of Legends), Battle.net (Overwatch 2, Diablo IV), Epic Games (Fortnite, Rocket League), Ubisoft Connect, Roblox, GOG Galaxy, Jagex Launcher and Discord. No passwords are stored and session data is encrypted at rest. Includes a GUI and a scriptable CLI.",
    "homepage": "https://github.com/klNuno/accshift",
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "skip"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/installer/nsis-header.bmp",
        "sidebarImage": "icons/installer/nsis-sidebar.bmp",
        "installMode": "currentUser",
        "startMenuFolder": "Accshift",
        "languages": [
          "English",
          "French",
          "Spanish",
          "Portuguese",
          "PortugueseBR",
          "Russian",
          "SimpChinese"
        ],
        "displayLanguageSelector": false,
        "compression": "lzma",
        "installerHooks": "./bundle/hooks.nsh"
      },
      "wix": {
        "language": "en-US",
        "bannerPath": "icons/installer/wix-banner.bmp",
        "dialogImagePath": "icons/installer/wix-dialog.bmp"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libdbus-1-3",
          "libxkbcommon0",
          "libxkbcommon-x11-0"
        ],
        "section": "utils"
      },
      "rpm": {
        "depends": [
          "dbus-libs",
          "libxkbcommon",
          "libxkbcommon-x11"
        ],
        "epoch": 0
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "11.0",
      "exceptionDomain": "",
      "signingIdentity": null,
      "providerShortName": null,
      "entitlements": null
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "accshift"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY5QjgxOUY2RjJFMjU5NTMKUldSVFdlTHk5aG00YVVla0RIQ25oZGlMc2tWRVVMTUQrSG96bUtiQ2ZLNFlSRkpmS1pGcVlKSzcK",
      "endpoints": [
        "https://github.com/klNuno/accshift/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
